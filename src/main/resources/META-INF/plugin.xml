<idea-plugin>
    <id>com.github.enzperesafonso.intellij-fits-viewer</id>
    <name>%plugin.name</name>
    <vendor email="support@example.com" url="https://github.com/enzperesafonso/intellij-fits-viewer">enzperesafonso</vendor>

    <description>%plugin.description</description>

    <!-- Product and plugin compatibility requirements -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="FITS"
                  implementationClass="org.example.FitsFileType"
                  fieldName="INSTANCE"
                  language="FITS"
                  extensions="fits;fit;fz"/>

        <fileEditorProvider implementation="org.example.FitsFileEditorProvider"/>
    </extensions>

    <change-notes><![CDATA[
      <b>1.0.0</b>
      <ul>
        <li>Initial release of the FITS Viewer plugin.</li>
        <li>Displays FITS header keywords and values in a table.</li>
        <li>Shows primary image data with a 5th-95th percentile linear stretch.</li>
      </ul>
    ]]></change-notes>

    <!-- Plugin version. This will be overwritten by Gradle. -->
    <version>VERSION_PLACEHOLDER</version>

    <!-- Compatibility settings -->
    <idea-version since-build="232"/>
    <resource-bundle>messages.FitsViewerBundle</resource-bundle>
</idea-plugin>